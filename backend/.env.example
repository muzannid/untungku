# ==========================================
# Application
# ==========================================
PROJECT_NAME="UntungKu API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# ==========================================
# Auth
# ==========================================
# Generate a real one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="your-super-secret-jwt-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# Database
# ==========================================
# Local development uses SQLite and needs no installation.
# If DATABASE_URL is omitted, the app uses backend/untungku.db automatically.
# DATABASE_URL="sqlite:///./untungku.db"

# Production / final stack (PostgreSQL):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/untungku_db"

# ==========================================
# CORS (comma separated)
# ==========================================
BACKEND_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
